<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- Registration, mapping, and event dispatch can be tested without an Apple SDK. Native calls are only used by the Apple smoke app. -->
  <ItemGroup>
    <Compile Include="..\Plugin.InAppBilling\Shared\*.cs" LinkBase="Shared" />
    <Compile Include="..\Plugin.InAppBilling\CrossInAppBilling.shared.cs" Link="CrossInAppBilling.shared.cs" />
    <Compile Include="..\Plugin.InAppBilling\StoreKit2\StoreKit2Models.apple.cs" Link="StoreKit2Models.apple.cs" />
    <Compile Include="..\Plugin.InAppBilling\StoreKit2\StoreKit2EventDispatcher.apple.cs" Link="StoreKit2EventDispatcher.apple.cs" />
    <Compile Include="..\Plugin.InAppBilling\StoreKit2\StoreKit2Native.apple.cs" Link="StoreKit2Native.apple.cs" />
  </ItemGroup>

</Project>
